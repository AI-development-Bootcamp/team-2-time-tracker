{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "noEmit": true,
        "types": [
            "vite/client"
        ],
        "baseUrl": ".",
        "paths": {
            "@shared/types": ["../../../shared/types/src/index.ts"],
            "@shared/types/*": ["../../../shared/types/src/*"]
        }
    },
    "include": [
        "src"
    ],
    "references": [
        { "path": "../../../shared/types" }
    ]
}