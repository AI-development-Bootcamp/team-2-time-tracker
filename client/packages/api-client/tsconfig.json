{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@shared/types": [
                "../../../shared/types/src/index.ts"
            ],
            "@shared/types/*": [
                "../../../shared/types/src/*"
            ]
        },
        "types": [
            "vite/client"
        ]
    },
    "include": [
        "src"
    ]
}