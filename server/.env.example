NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user@localhost:5432/timetracker
JWT_SECRET=your-very-secure-jwt-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173

# IDrive e2 Storage Configuration (S3-compatible)
# Required for document upload functionality
IDRIVE_ACCESS_KEY=your_access_key
IDRIVE_SECRET_KEY=your_secret_key
IDRIVE_BUCKET=your_bucket_name
IDRIVE_ENDPOINT=https://endpoint.idrivee2.com
IDRIVE_REGION=us-east-1
