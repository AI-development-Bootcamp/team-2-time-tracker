{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "..",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": {
      "@shared/types": [
        "../shared/types/src/index.ts"
      ],
      "@shared/types/*": [
        "../shared/types/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../shared/types/src/**/*",
    "prisma.config.ts"
  ]
}