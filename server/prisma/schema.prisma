// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUM Types
// =========================

enum UserRole {
  EMPLOYEE
  ADMIN
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum TaskStatus {
  OPEN
  CLOSED
}

enum WorkLocation {
  OFFICE
  CLIENT
  HOME
}

enum TimeEntrySource {
  MANUAL
  TIMER
}

enum ReportType {
  TOTAL_HOURS
  ENTRY_EXIT
}

enum AbsenceType {
  VACATION
  SICK
  RESERVES
  OTHER
}

enum AbsenceStatus {
  PENDING_DOCUMENT
  SUBMITTED
}

enum WorkdayStatus {
  MISSING
  FULL
  EXCEPTION
}

// =========================
// User & Auth Models
// =========================

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  password           String
  fullName           String            @map("full_name")
  role               UserRole          @default(EMPLOYEE)
  isActive           Boolean           @default(true) @map("is_active")
  mustChangePassword Boolean           @default(true) @map("must_change_password")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  refreshTokens      RefreshToken[]
  assignments        TaskAssignment[]
  timers             Timer[]
  timeEntries        TimeEntry[]
  deletedTimeEntries TimeEntry[]       @relation("DeletedTimeEntries")
  workdaySummaries   WorkdaySummary[]
  lockedMonths       MonthLock[]       @relation("LockedByAdmin")
  unlockedMonths     MonthLock[]       @relation("UnlockedByAdmin")
  assignedTasks      TaskAssignment[]  @relation("AssignedByAdmin")
  absenceRequests    AbsenceRequest[]
  absenceDays        AbsenceDay[]
  uploadedDocuments  AbsenceDocument[] @relation("UploadedDocuments")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// =========================
// Client / Project / Task Models
// =========================

model Client {
  id          String       @id @default(uuid())
  name        String
  description String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  projects Project[]

  @@index([status])
  @@index([name])
  @@map("clients")
}

model Project {
  id          String       @id @default(uuid())
  clientId    String       @map("client_id")
  name        String
  description String?
  status      EntityStatus @default(ACTIVE)
  reportType  ReportType   @default(TOTAL_HOURS) @map("report_type")
  startDate   DateTime?    @map("start_date") @db.Date
  endDate     DateTime?    @map("end_date") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id])
  tasks  Task[]

  @@index([clientId, status])
  @@index([clientId, name])
  @@map("projects")
}

model Task {
  id          String     @id @default(uuid())
  projectId   String     @map("project_id")
  name        String
  description String?
  status      TaskStatus @default(OPEN)
  startDate   DateTime?  @map("start_date") @db.Date
  endDate     DateTime?  @map("end_date") @db.Date
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  project     Project          @relation(fields: [projectId], references: [id])
  assignments TaskAssignment[]
  timeEntries TimeEntry[]

  @@index([projectId, status])
  @@index([projectId, name])
  @@map("tasks")
}

model TaskAssignment {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id])
  taskId            String   @map("task_id")
  task              Task     @relation(fields: [taskId], references: [id])
  assignedByAdminId String   @map("assigned_by_admin_id")
  assignedByAdmin   User     @relation("AssignedByAdmin", fields: [assignedByAdminId], references: [id])
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
  @@map("task_assignments")
}

// =========================
// Absence Models
// =========================

model AbsenceRequest {
  id            String            @id @default(uuid())
  userId        String            @map("user_id")
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          AbsenceType
  startDate     DateTime          @map("start_date") @db.Date
  endDate       DateTime          @map("end_date") @db.Date
  isHalfDay     Boolean           @default(false) @map("is_half_day")
  status        AbsenceStatus     @default(SUBMITTED)
  note          String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  absenceDays   AbsenceDay[]
  documents     AbsenceDocument[]

  @@index([userId, startDate, endDate])
  @@index([status])
  @@index([type])
  @@map("absence_requests")
}

model AbsenceDay {
  id               String         @id @default(uuid())
  absenceRequestId String         @map("absence_request_id")
  absenceRequest   AbsenceRequest @relation(fields: [absenceRequestId], references: [id], onDelete: Cascade)
  userId           String         @map("user_id")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDate         DateTime       @map("work_date") @db.Date
  minutes          Int
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([userId, workDate, absenceRequestId])
  @@index([userId, workDate])
  @@index([absenceRequestId])
  @@map("absence_days")
}

model AbsenceDocument {
  id               String         @id @default(uuid())
  absenceRequestId String         @map("absence_request_id")
  absenceRequest   AbsenceRequest @relation(fields: [absenceRequestId], references: [id], onDelete: Cascade)
  fileUrl          String         @map("file_url")
  fileName         String?        @map("file_name")
  mimeType         String?        @map("mime_type")
  fileSize         Int?           @map("file_size")
  uploadedByUserId String         @map("uploaded_by_user_id")
  uploadedBy       User           @relation("UploadedDocuments", fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime       @default(now()) @map("uploaded_at")

  @@index([absenceRequestId])
  @@map("absence_documents")
}

// =========================
// Month Lock Model
// =========================

model MonthLock {
  id                String           @id @default(uuid())
  month             DateTime         @unique @db.Date
  lockedAt          DateTime         @map("locked_at")
  lockedByAdminId   String           @map("locked_by_admin_id")
  lockedByAdmin     User             @relation("LockedByAdmin", fields: [lockedByAdminId], references: [id])
  unlockedAt        DateTime?        @map("unlocked_at")
  unlockedByAdminId String?          @map("unlocked_by_admin_id")
  unlockedByAdmin   User?            @relation("UnlockedByAdmin", fields: [unlockedByAdminId], references: [id])
  workdaySummaries  WorkdaySummary[]

  @@index([month])
  @@map("month_locks")
}

model WorkdaySummary {
  id                 String        @id @default(uuid())
  userId             String        @map("user_id")
  workDate           DateTime      @map("work_date") @db.Date
  targetMinutes      Int           @default(540) @map("target_minutes")
  workMinutes        Int           @default(0) @map("work_minutes")
  absenceMinutes     Int           @default(0) @map("absence_minutes")
  status             WorkdayStatus @default(MISSING)
  isLocked           Boolean       @default(false) @map("is_locked")
  lockedMonthId      String?   @map("locked_month_id")
  isSubmitted        Boolean   @default(false) @map("is_submitted")
  submittedAt        DateTime? @map("submitted_at")
  requiresExactTotal Boolean   @default(false) @map("requires_exact_total")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user        User       @relation(fields: [userId], references: [id])
  lockedMonth MonthLock? @relation(fields: [lockedMonthId], references: [id])

  @@unique([userId, workDate])
  @@index([isLocked])
  @@map("workday_summaries")
}

// =========================
// Timer Model
// =========================

model Timer {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id])
  workDate        DateTime    @map("work_date") @db.Date
  startedAt       DateTime    @map("started_at")
  stoppedAt       DateTime?   @map("stopped_at")
  durationMinutes Int?        @map("duration_minutes")
  isRunning       Boolean     @default(true) @map("is_running")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  timeEntries     TimeEntry[]

  @@index([userId, workDate])
  @@index([userId, isRunning])
  @@map("timers")
}

// =========================
// Time Entry Model
// =========================

model TimeEntry {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  user            User            @relation(fields: [userId], references: [id])
  workDate        DateTime        @map("work_date") @db.Date
  location        WorkLocation
  startTime       DateTime        @map("start_time") @db.Time()
  endTime         DateTime        @map("end_time") @db.Time()
  durationMinutes Int             @map("duration_minutes")
  taskId          String          @map("task_id")
  task            Task            @relation(fields: [taskId], references: [id])
  description     String
  source          TimeEntrySource @default(MANUAL)
  timerId         String?         @map("timer_id")
  timer           Timer?          @relation(fields: [timerId], references: [id])
  isDeleted       Boolean         @default(false) @map("is_deleted")
  deletedAt       DateTime?       @map("deleted_at")
  deletedByUserId String?         @map("deleted_by_user_id")
  deletedByUser   User?           @relation("DeletedTimeEntries", fields: [deletedByUserId], references: [id])
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([userId, workDate])
  @@index([taskId])
  @@index([userId, taskId])
  @@map("time_entries")
}


